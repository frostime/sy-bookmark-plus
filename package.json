{
  "name": "sy-bookmark-plus",
  "version": "2.3.2",
  "type": "module",
  "description": "A more powerful bookmark",
  "repository": "https://github.com/frostime/sy-bookmark-plus",
  "homepage": "https://github.com/frostime/sy-bookmark-plus",
  "author": "frostime",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm run clean && cross-env NODE_ENV=development VITE_SOURCEMAP=inline vite build --watch",
    "check": "pnpm run check:types",
    "test": "node --conditions=browser --test tests/*.test.cjs",
    "check:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "clean": "node ./scripts/clean.js",
    "build": "pnpm run clean && pnpm run build:app",
    "build:app": "cross-env NODE_ENV=production vite build",
    "build-srcmap": "cross-env NODE_ENV=production VITE_SOURCEMAP=inline vite build",
    "make-link": "node --no-warnings ./scripts/make_dev_link.js",
    "make-link-win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/elevate.ps1 -scriptPath ./scripts/make_dev_link.js",
    "make-install": "pnpm run build && node --no-warnings ./scripts/make_install.js",
    "make-test-install": "pnpm run build-srcmap && node --no-warnings ./scripts/make_install.js",
    "update-version": "node --no-warnings ./scripts/update_version.js"
  },
  "devDependencies": {
    "@types/livereload": "^0.9.5",
    "@types/node": "^26.4.0",
    "cross-env": "^10.1.0",
    "fast-glob": "^3.3.3",
    "glob": "^13.0.6",
    "js-yaml": "^5.4.1",
    "livereload": "^0.9.3",
    "minimist": "^1.2.8",
    "sass": "^1.103.1",
    "siyuan": "1.2.9",
    "solid-js": "^1.9.17",
    "solid-styled-jsx": "^0.27.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-zip-pack": "^1.2.4"
  },
  "dependencies": {
    "@frostime/siyuan-plugin-kits": "^1.7.0",
    "@frostime/solid-signal-ref": "^2.2.0",
    "solid-transition-group": "^0.3.0"
  }
}
